# NVIDIA NIM — get a key at https://build.nvidia.com/settings
NVIDIA_API_KEY=

# Chat / generation. Swap freely; both are on the free trial tier.
#   nvidia/nemotron-3.5-lightning-30b-a3b   fast MoE, good default
#   nvidia/nemotron-3-ultra-550b-a55b       larger, slower, better reasoning
CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Embedding models
EMBED_MODEL=nvidia/nemotron-3-embed-1b
TEXT_DIM=2048

CLIP_MODEL=nvidia/nvclip
CLIP_DIM=1024

# --- Qdrant ---
# Either a full URL...
QDRANT_URL=https://your-qdrant-host:6333
# ...or host + port:
# QDRANT_HOST=your-qdrant-host
# QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
COLLECTION_PREFIX=docchat

# --- Retrieval tuning ---
TOP_K=6
CHUNK_CHARS=1400
CHUNK_OVERLAP=200
EMBED_BATCH=16
CLIP_BATCH=8
MAX_UPLOAD_BYTES=26214400

# --- OCR (image and scanned-page text extraction) ---
# A plain VLM, not a *-reasoning model: reasoning models burn their budget
# thinking and leave a garbled fragment instead of a clean transcription.
OCR_MODEL=meta/llama-3.2-11b-vision-instruct
OCR_ENABLED=true
OCR_MAX_PER_DOC=30
# Free-tier vision calls hit a 16/16 worker cap, so be patient.
OCR_ATTEMPTS=10

# --- First admin account ---
# Created on startup ONLY if no admin exists yet, so these can be deleted
# from .env once you have signed in and changed the password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Telegram bot (optional, long-polling, admin-only) ---
# Token from @BotFather. Admin IDs are comma-separated telegram numeric user ids.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
